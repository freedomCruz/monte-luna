# Monteluna environment template
# Deployed to VPS as /srv/monteluna/.env (chmod 0600)
# Contains only safe placeholder values. Real secrets must never be committed.

# Release metadata (set by deployment script, format: <vX.Y.Z>-<7-char SHA>)
MONTELUNA_RELEASE=

# Domain and ACME configuration (first deploy: staging.montelunaco.com)
SITE_ADDRESS=staging.montelunaco.com
ACME_EMAIL=admin@example.com

# PostgreSQL database credentials (internal to Docker network)
POSTGRES_USER=monteluna
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=monteluna

# Backend API configuration
API_ADDR=:8080
DATABASE_URL=postgres://monteluna:replace_with_strong_password@postgres:5432/monteluna?sslmode=disable
MEDIA_BASE_URL=https://media.example.com
TRACKING_TOKEN_SECRET=replace_with_base64_encoded_32_bytes_secret
ORDER_MAINTENANCE_INTERVAL=1m

# Identity encryption key for TOTP secrets and one-time token payloads
# (docs/domain/identity.md). Standard base64 of exactly 32 random bytes; the API
# refuses to start otherwise. Generate it on the host: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_base64_encoded_32_bytes_key

# Transactional email (docs/domain/notifications.md). "capture" keeps rendered
# emails only in process memory; staging stays on capture until a sending domain
# is verified in Resend. "resend" requires all three RESEND_* values.
NOTIFICATIONS_EMAIL_SENDER=capture
# RESEND_API_KEY=re_replace_me
# RESEND_FROM=Monteluna <no-reply@example.com>
# RESEND_WEBHOOK_SECRET=whsec_replace_me

# Payments integration (Wompi Colombia)
# Environment must be sandbox or production
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=pub_stag_placeholder
WOMPI_PRIVATE_KEY=prv_stag_placeholder
WOMPI_INTEGRITY_SECRET=stag_integrity_placeholder
WOMPI_EVENTS_SECRET=stag_events_placeholder
STOREFRONT_BASE_URL=https://staging.montelunaco.com
PAYMENT_WEBHOOK_RETENTION=720h

# Transactional Outbox relay configuration
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_CLEANUP_INTERVAL=1h
OUTBOX_RETENTION=168h
OUTBOX_INITIAL_BACKOFF=1s
OUTBOX_MAX_BACKOFF=1m
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
