# Cloudflare R2 S3-compatible repository endpoint
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>

# Cloudflare R2 API Token credentials (scoped to the backup bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Path to the repository encryption password file (must be mode 0600)
RESTIC_PASSWORD_FILE=/srv/monteluna/restic.pw
