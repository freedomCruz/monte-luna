[Unit]
Description=Monteluna daily database and certificate backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/srv/monteluna/backup.sh
# ProtectHome hides /root/.cache, so restic gets a systemd-managed cache.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic

# Systemd hardening while preserving Docker daemon access
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/monteluna /tmp /var/run/docker.sock
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
