{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	# Site-wide root so handle_errors can serve /404.html as well.
	root * /srv

	# Caddy renames the ETag of every response it compresses ("3" becomes
	# "3-gzip"), and the admin API uses strong ETags for optimistic locking: the
	# browser would return an If-Match the API rejects with 400. Admin traffic is
	# small and authenticated, so it is served uncompressed. Static assets and the
	# public storefront API keep compression.
	@compressible not path /api/v1/admin/*
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	# Pending infrastructure improvement: configure granular Cache-Control policies
	# to avoid stale asset references across deployments:
	# - HTML documents (root, /tienda, /admin/*): Cache-Control "no-cache, must-revalidate"
	# - Hashed build assets (/_astro/*, /fonts/*): Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		file_server {
			precompressed zstd gzip
		}
	}

	handle_errors {
		@404 expression `{err.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}
}
