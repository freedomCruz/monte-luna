{
  "name": "monteluna-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc --project e2e/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types:generate": "openapi-typescript ../contracts/openapi/platform.yaml -o src/generated/platform.ts && openapi-typescript ../contracts/openapi/catalog.yaml -o src/generated/catalog.ts && openapi-typescript ../contracts/openapi/orders.yaml -o src/generated/orders.ts && openapi-typescript ../contracts/openapi/payments.yaml -o src/generated/payments.ts && node scripts/generate-divipola.mjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@nanostores/persistent": "1.3.5",
    "@nanostores/react": "2.0.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "nanostores": "1.5.5",
    "oxc-transform-react": "0.145.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "overrides": {
    "@vitejs/plugin-react": "6.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
