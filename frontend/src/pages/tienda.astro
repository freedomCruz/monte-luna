---
import Layout from '../layouts/Layout.astro';
import { getCatalogProducts, getCatalogCategories } from '../lib/catalog';
import { groupProductsByCategory } from '../lib/catalog-groups';
import { ListingPriceIsland } from '../components/islands/ListingPriceIsland';

const productsPage = await getCatalogProducts();
const categoriesPage = await getCatalogCategories();

const products = productsPage.items;
const categories = categoriesPage.items;

const categoryGroups = groupProductsByCategory(products, categories);
const allProductSlugs = Array.from(new Set(products.map((p) => p.slug)));
---

<Layout title="Tienda · Monteluna" description="Catálogo de cafés de especialidad y cacaos finos de aroma Monteluna.">
  <!-- Shop Hero Section -->
  <section class="bg-brand-sand py-12 md:py-16 border-b border-foreground/10">
    <div class="max-w-[1320px] mx-auto px-6 md:px-12 flex flex-col gap-4">
      <nav aria-label="Ruta de navegación" class="flex items-center gap-2 text-sm font-semibold text-foreground/70">
        <a href="/" class="hover:underline">Inicio</a>
        <span aria-hidden="true">/</span>
        <span class="text-foreground">Tienda</span>
      </nav>

      <span class="font-condensed text-brand-burgundy text-lg font-bold uppercase tracking-wider">
        Nuestra Cosecha
      </span>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight text-foreground">
        Café y Cacao de Origen
      </h1>
      <p class="text-lg md:text-xl text-foreground/80 max-w-2xl leading-relaxed">
        {products.length} productos · lotes de café arábica y barras de cacao fino de aroma, cultivados por familias productoras en Colombia.
      </p>

      <!-- Category Filter Navigation (M-Listado category tabs) -->
      <nav aria-label="Filtrar por categoría" class="flex flex-wrap items-center gap-3 mt-6">
        <a
          href="/tienda"
          class="px-5 py-2.5 rounded-xl font-bold text-sm uppercase tracking-wider transition-colors bg-foreground text-brand-sand"
        >
          Todos ({products.length})
        </a>
        {categoryGroups.map((group) => (
          <a
            href={`#${group.id}`}
            class="px-5 py-2.5 rounded-xl font-bold text-sm uppercase tracking-wider transition-colors bg-card text-foreground hover:bg-brand-yellow/30 border border-foreground/10"
          >
            {group.category.name} ({group.products.length})
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Grouped Category Sections per M-Listado -->
  <main class="max-w-[1320px] mx-auto px-6 md:px-12 py-12 md:py-16 flex flex-col gap-16 md:gap-20">
    {categoryGroups.map((group) => {
      const isForest = group.theme === 'forest';
      const isBurgundy = group.theme === 'burgundy';
      const bannerBg = isForest ? 'bg-brand-forest text-brand-sand' : isBurgundy ? 'bg-brand-burgundy text-brand-sand' : 'bg-brand-sand text-foreground';
      const labelColor = isForest || isBurgundy ? 'text-brand-yellow' : 'text-brand-burgundy';

      return (
        <section
          id={group.id}
          aria-labelledby={`heading-${group.id}`}
          class="scroll-mt-8 flex flex-col gap-8"
        >
          <!-- Category Header Banner -->
          <div class={`p-8 md:p-12 rounded-2xl flex flex-col md:flex-row md:items-end justify-between gap-6 ${bannerBg}`}>
            <div class="flex flex-col gap-3 max-w-2xl">
              <span class={`font-condensed text-sm font-bold uppercase tracking-widest ${labelColor}`}>
                {group.category.name} · {group.products.length} {group.products.length === 1 ? 'producto' : 'productos'}
              </span>
              <h2 id={`heading-${group.id}`} class="text-3xl md:text-5xl font-black tracking-tight leading-tight">
                {group.headline}
              </h2>
              {group.description && (
                <p class="text-base md:text-lg opacity-90 leading-relaxed">
                  {group.description}
                </p>
              )}
            </div>
            <a
              href="#top"
              class="self-start md:self-end text-xs font-bold uppercase tracking-wider opacity-80 hover:opacity-100 underline underline-offset-4"
            >
              Volver arriba ↑
            </a>
          </div>

          <!-- Category Products Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {group.products.map((product) => {
              const coverImage = product.images[0]?.url || '/images/photo-roasted-beans-pile.jpg';
              const coverAlt = product.images[0]?.alt_text || product.title;

              // Extract key display attributes
              const processAttr = product.attributes.find((a) => a.key === 'process')?.display_value;
              const varietyAttr = product.attributes.find((a) => a.key === 'varieties')?.display_value;
              const roastAttr = product.attributes.find((a) => a.key === 'roast_level')?.display_value;
              const notesAttr = product.attributes.find((a) => a.key === 'tasting_notes')?.display_value;
              const cacaoPct = product.attributes.find((a) => a.key === 'cacao_percentage')?.display_value;

              return (
                <article
                  id={`product-${group.category.slug}-${product.slug}`}
                  data-category={group.category.slug}
                  data-product-type={product.product_type.slug}
                  class="group bg-card rounded-2xl overflow-hidden border border-foreground/10 flex flex-col transition-all hover:shadow-lg"
                >
                  <!-- Product Card Image -->
                  <a href={`/productos/${product.slug}`} class="block aspect-[4/3] overflow-hidden bg-brand-sand/50 relative">
                    <img
                      src={coverImage}
                      alt={coverAlt}
                      loading="lazy"
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                    />
                    {product.product_type && (
                      <span class="absolute top-4 left-4 bg-foreground text-brand-sand font-condensed text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-lg shadow-sm">
                        {product.product_type.name}
                      </span>
                    )}
                  </a>

                  <!-- Product Card Content -->
                  <div class="p-6 flex flex-col flex-1 gap-4">
                    <div class="flex flex-col gap-1.5">
                      {product.origin && (
                        <a
                          href={`/origenes/${product.origin.slug}`}
                          class="font-condensed text-xs font-bold uppercase tracking-wider text-brand-forest hover:text-brand-burgundy transition-colors inline-flex items-center gap-1"
                        >
                          <span>{product.origin.name}</span>
                          <span aria-hidden="true">→</span>
                        </a>
                      )}
                      <h3 class="text-2xl font-black text-foreground group-hover:text-brand-burgundy transition-colors leading-tight">
                        <a href={`/productos/${product.slug}`}>
                          {product.title}
                        </a>
                      </h3>
                    </div>

                    <!-- Product Attributes Badges -->
                    <div class="flex flex-wrap gap-2 text-xs font-semibold text-foreground/80">
                      {cacaoPct && (
                        <span class="bg-brand-sand px-2.5 py-1 rounded-md border border-foreground/5">
                          {cacaoPct}% Cacao
                        </span>
                      )}
                      {processAttr && (
                        <span class="bg-brand-sand px-2.5 py-1 rounded-md border border-foreground/5">
                          {processAttr}
                        </span>
                      )}
                      {roastAttr && (
                        <span class="bg-brand-sand px-2.5 py-1 rounded-md border border-foreground/5">
                          Tueste {roastAttr}
                        </span>
                      )}
                      {varietyAttr && (
                        <span class="bg-brand-sand px-2.5 py-1 rounded-md border border-foreground/5">
                          {varietyAttr}
                        </span>
                      )}
                    </div>

                    {notesAttr && (
                      <p class="text-xs text-foreground/70 italic line-clamp-2">
                        Notas: {notesAttr}
                      </p>
                    )}

                    {product.description && (
                      <p class="text-sm text-foreground/80 line-clamp-3 leading-relaxed mt-auto">
                        {product.description}
                      </p>
                    )}

                    <!-- Price & CTA slot (F1 requirement: static placeholder, no hardcoded price, no add-to-cart button) -->
                    <div class="pt-4 mt-auto border-t border-foreground/5 flex items-center justify-between gap-4">
                      <div
                        data-live-price-slot={product.slug}
                        class="min-h-[28px] flex items-center"
                      >
                        <span class="text-xs font-medium text-foreground/60 italic">
                          Consultando precio...
                        </span>
                      </div>
                      <a
                        href={`/productos/${product.slug}`}
                        class="font-condensed text-sm font-bold uppercase tracking-wider px-4 py-2 rounded-xl bg-brand-yellow text-foreground hover:bg-brand-yellow/80 transition-colors"
                      >
                        Ver detalle
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <!-- Headless live price hydration island mounted with client:load:
         its only job is the on-load batch fetch for card price slots without DOM box/intersection requirements -->
    <ListingPriceIsland client:load productSlugs={allProductSlugs} />
  </main>
</Layout>

