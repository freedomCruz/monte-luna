# Copy to .env for local development: cp .env.example .env
   # Never commit .env. Values here are local placeholders, not secrets.

   # Local PostgreSQL started by compose.yaml (task dev:db:up)
   POSTGRES_USER=ecommerce
   POSTGRES_PASSWORD=local-dev-only-change-me
   POSTGRES_DB=ecommerce
   POSTGRES_PORT=5432

   # Replace with values from task setup:preview in each worktree.
   WORKTREE_DB=ecommerce_w000000000000
   API_ADDR=127.0.0.1:18000
   FRONTEND_PORT=19000

   # Backend secret for guest order tracking tokens (docs/domain/orders.md).
   # At least 32 random bytes, base64-encoded. Generate one with: openssl rand -base64 32
   TRACKING_TOKEN_SECRET=replace-with-openssl-rand-base64-32

# Wompi Colombia payments (docs/domain/payments.md). Sandbox keys come from the
# Wompi dashboard; never commit real values.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=pub_test_replace_me
WOMPI_PRIVATE_KEY=prv_test_replace_me
WOMPI_INTEGRITY_SECRET=test_integrity_replace_me
WOMPI_EVENTS_SECRET=test_events_replace_me

# Absolute storefront origin used to build the Wompi redirect URL to /pedido.
# Locally, Taskfile.yml derives it from LOCAL_STOREFRONT_HOST and this worktree's
# FRONTEND_PORT and overrides this value; it applies when running without Task.
STOREFRONT_BASE_URL=http://localhost:4321

# Local development only: host name for the storefront in the browser. Leave unset
# for 127.0.0.1. Wompi sandbox tests need a name such as monteluna.test mapped to
# 127.0.0.1 in the hosts file (docs/development/local-wompi-sandbox.md).
# LOCAL_STOREFRONT_HOST=monteluna.test

# AES-256-GCM key for TOTP secrets and one-time token outbox payloads
# (docs/domain/identity.md). Standard base64 of exactly 32 random bytes; the API
# refuses to start otherwise. Generate one with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Transactional email (docs/domain/notifications.md). Unset or "capture" keeps
# rendered emails only in process memory for local inspection and tests.
# "resend" requires the three RESEND_* values below and a verified sending domain;
# the API refuses to start when any of them is missing.
NOTIFICATIONS_EMAIL_SENDER=capture
# RESEND_API_KEY=re_replace_me
# RESEND_FROM=Monteluna <no-reply@example.com>
# RESEND_WEBHOOK_SECRET=whsec_replace_me
