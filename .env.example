# Copy to .env for local development: cp .env.example .env
   # Never commit .env. Values here are local placeholders, not secrets.

   # Local PostgreSQL started by compose.yaml (task dev:db:up)
   POSTGRES_USER=ecommerce
   POSTGRES_PASSWORD=local-dev-only-change-me
   POSTGRES_DB=ecommerce
   POSTGRES_PORT=5432

   # Replace with values from task setup:preview in each worktree.
   WORKTREE_DB=ecommerce_w000000000000
   API_ADDR=127.0.0.1:18000
   FRONTEND_PORT=19000

   # Backend secret for guest order tracking tokens (docs/domain/orders.md).
   # At least 32 random bytes, base64-encoded. Generate one with: openssl rand -base64 32
   TRACKING_TOKEN_SECRET=replace-with-openssl-rand-base64-32

# Wompi Colombia payments (docs/domain/payments.md). Sandbox keys come from the
# Wompi dashboard; never commit real values.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=pub_test_replace_me
WOMPI_PRIVATE_KEY=prv_test_replace_me
WOMPI_INTEGRITY_SECRET=test_integrity_replace_me
WOMPI_EVENTS_SECRET=test_events_replace_me

# Absolute storefront origin used to build the Wompi redirect URL to /pedido.
STOREFRONT_BASE_URL=http://localhost:4321
